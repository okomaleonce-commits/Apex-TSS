__pycache__/
*.py[cod]
*.egg-info/
.env
data/*.jsonl
logs/*.log
reports/*.csv
reports/*.md
# NE PAS ignorer fbref_cache.db — il est commité pour Render
runs/.cache/
runs_hockey/.cache/
runs_turf/.cache/
runs_mi/.cache/

# sorties de run APEX-MI (éphémères, par exécution) — on ne versionne que le .gitkeep
runs_mi/*
!runs_mi/.gitkeep

# cache historique football-data (retéléchargeable)
data/history/*
!data/history/intl_supplement.csv
data/apifootball/history/
data/footystats/
data/tsbase/
data/worm/
reports/worm/
data/sync/

# APEX-CHARACTER (sorties générées)
data/character/
backtests/character-*/

# État durable généré (APEX-LEDGER, étape 2) — non versionné
state/

# Règlements MI générés à l'exécution (append-only, non versionné ; audit point 4)
journal/apex_mi_settlements.csv

# APEX-FUSION (digest généré, éphémère)
reports/fusion/
data/fusion/

# APEX-SOURCES (cache CSV football-data, retéléchargeable)
data/sources/

# APEX NEWSDESK (actualité week-end générée, append-only, non versionnée)
data/newsdesk/

# APEX-TURF-WORM / APEX-TURF-MI (meme convention que le WORM football :
# snapshots et rapports partent en artefacts CI, pas en commits)
data/turf_worm/
reports/turf_worm/
runs_turf_mi/*
!runs_turf_mi/.gitkeep
